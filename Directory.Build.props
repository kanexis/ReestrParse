<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>kanexis</Authors>
    <VersionPrefix>0.5.0</VersionPrefix>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/kanexis/ReestrParse</RepositoryUrl>
    <PackageProjectUrl>https://github.com/kanexis/ReestrParse</PackageProjectUrl>
    <Description>WPF/Selenium crawler for collecting regulated organizations and Form 4.1.1 contact data from ФГИС ЕИАС.</Description>
  </PropertyGroup>
</Project>
