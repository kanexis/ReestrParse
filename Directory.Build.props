<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>kanexis</Authors>
    <VersionPrefix>0.8.0</VersionPrefix>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/kanexis/ReestrParse</RepositoryUrl>
    <PackageProjectUrl>https://github.com/kanexis/ReestrParse</PackageProjectUrl>
    <Description>WPF/Selenium crawler for ФГИС ЕИАС with full catalog pagination, parallel Form 4.1.1 contact parsing, pipeline telemetry, timing metrics and operator monitoring UI.</Description>
  </PropertyGroup>
</Project>
