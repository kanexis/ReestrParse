<Window x:Class="ReestrParse.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReestrParse"
        Width="1660"
        Height="920"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="276" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="32" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="REESTR" Foreground="White" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="PARSE" Foreground="#60A5FA" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="ФГИС ЕИАС" Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2">
          <TextBlock Text="PIPELINE" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12" />

          <Border CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentPipelineStep}" Value="1">
                    <Setter Property="Background" Value="#1F2937" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="14" Background="#2563EB">
                <TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Регион и фильтры" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RegionStepStatus}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="170" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentPipelineStep}" Value="2">
                    <Setter Property="Background" Value="#1F2937" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="14" BorderBrush="#475569" BorderThickness="1">
                <TextBlock Text="2" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Каталог" Foreground="#CBD5E1" />
                <TextBlock Text="{Binding CatalogStepStatus}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="170" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentPipelineStep}" Value="3">
                    <Setter Property="Background" Value="#1F2937" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="14" BorderBrush="#475569" BorderThickness="1">
                <TextBlock Text="3" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Карточки / формы" Foreground="#CBD5E1" />
                <TextBlock Text="{Binding ContactsStepStatus}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="170" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border CornerRadius="8" Padding="12">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentPipelineStep}" Value="4">
                    <Setter Property="Background" Value="#1F2937" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="14" BorderBrush="#475569" BorderThickness="1">
                <TextBlock Text="4" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Результат" Foreground="#CBD5E1" />
                <TextBlock Text="{Binding ExportStepStatus}" Foreground="#64748B" FontSize="11" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Row="4" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
          <StackPanel>
            <TextBlock Text="Stack" Foreground="#94A3B8" FontSize="11" />
            <TextBlock Text=".NET 10 · WPF · MVVM" Foreground="White" Margin="0,3,0,0" />
            <TextBlock Text="Selenium · AngleSharp" Foreground="#60A5FA" FontSize="11" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="32,26,32,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="20" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="16" />
        <RowDefinition Height="*" />
        <RowDefinition Height="16" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Каталог и контакты организаций"
                     FontSize="28"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="Сначала собираем каталог, затем параллельно читаем карточки, форму 4.1.1 и дополнительную форму 1.0.1."
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="13"
                     Margin="0,7,0,0" />
        </StackPanel>
        <Border DockPanel.Dock="Right"
                Background="#DCFCE7"
                CornerRadius="16"
                Padding="12,6"
                VerticalAlignment="Top">
          <TextBlock Text="{Binding StatusText}" Foreground="#166534" FontSize="12" />
        </Border>
      </DockPanel>

      <Border Grid.Row="2"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.1*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Text="Регион" FontWeight="SemiBold" Margin="0,0,0,7" />
            <ComboBox ItemsSource="{Binding Regions}"
                      SelectedItem="{Binding SelectedRegion}"
                      DisplayMemberPath="Name"
                      MinWidth="300" />
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="Сфера" FontWeight="SemiBold" Margin="0,0,0,7" />
            <ComboBox ItemsSource="{Binding Spheres}"
                      SelectedItem="{Binding SelectedSphere}"
                      DisplayMemberPath="Name"
                      MinWidth="210" />
          </StackPanel>

          <StackPanel Grid.Column="4">
            <TextBlock Text="Workers" FontWeight="SemiBold" Margin="0,0,0,7" />
            <ComboBox ItemsSource="{Binding ParallelismOptions}"
                      SelectedItem="{Binding SelectedParallelism}"
                      MinWidth="90" />
          </StackPanel>

          <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="Обновить регионы"
                      Command="{Binding LoadRegionsCommand}"
                      Background="#EEF2FF"
                      Foreground="#3730A3"
                      Margin="0,0,10,0" />
              <Button Content="1. Загрузить организации"
                      Command="{Binding LoadOrganizationsCommand}"
                      Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <CheckBox Content="Фоновые Chrome"
                        IsChecked="{Binding HeadlessDetails}"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0" />
              <Button Content="2. Загрузить данные форм"
                      Command="{Binding LoadContactsCommand}"
                      Background="#0F766E"
                      Foreground="White" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="4"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Margin="20,15">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <StackPanel>
              <TextBlock Text="Организации" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                <Run Text="Всего: " />
                <Run Text="{Binding Organizations.Count, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text=" · данные форм заполняются по мере завершения workers" />
              </TextBlock>
            </StackPanel>

            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Поиск по названию, ИНН, КПП, контактам, формам, системам и территориям"
                     VerticalAlignment="Center" />
          </Grid>

          <DataGrid Grid.Row="1"
                    ItemsSource="{Binding FilteredOrganizations}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    RowHeight="40"
                    ColumnHeaderHeight="44"
                    FrozenColumnCount="1"
                    Margin="1"
                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.RowDetailsTemplate>
              <DataTemplate>
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,1" Padding="18,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Распознано форм" Foreground="#64748B" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding ParsedForms}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Дата раскрытия" Foreground="#64748B" FontSize="11" />
                    <TextBlock Grid.Column="3" Text="{Binding DisclosureUpdatedAt}" />

                    <TextBlock Grid.Row="1" Text="Сайт" Foreground="#64748B" FontSize="11" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Website}" TextWrapping="Wrap" Margin="0,7,12,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Должность ответственного" Foreground="#64748B" FontSize="11" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ResponsiblePosition}" TextWrapping="Wrap" Margin="0,7,0,0" />

                    <TextBlock Grid.Row="2" Text="Почтовый адрес" Foreground="#64748B" FontSize="11" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PostalAddress}" TextWrapping="Wrap" Margin="0,7,12,0" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Адрес местонахождения" Foreground="#64748B" FontSize="11" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding LocationAddress}" TextWrapping="Wrap" Margin="0,7,0,0" />

                    <TextBlock Grid.Row="3" Text="Системы инфраструктуры" Foreground="#64748B" FontSize="11" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InfrastructureSystems}" TextWrapping="Wrap" Margin="0,7,12,0" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Виды деятельности" Foreground="#64748B" FontSize="11" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding RegulatedActivities}" TextWrapping="Wrap" Margin="0,7,0,0" />

                    <TextBlock Grid.Row="4" Text="Территория оказания услуг" Foreground="#64748B" FontSize="11" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ServiceTerritory}" TextWrapping="Wrap" Margin="0,7,0,0" />

                    <TextBlock Grid.Row="5" Text="Диагностика данных" Foreground="#64748B" FontSize="11" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DataWarnings}" TextWrapping="Wrap" Foreground="#92400E" Margin="0,7,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </DataGrid.RowDetailsTemplate>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Организация" Binding="{Binding Name}" Width="310" />
              <DataGridTextColumn Header="ИНН" Binding="{Binding Inn}" Width="120" />
              <DataGridTextColumn Header="КПП" Binding="{Binding Kpp}" Width="115" />
              <DataGridTextColumn Header="orgId" Binding="{Binding OrganizationId}" Width="100" />
              <DataGridTextColumn Header="Телефон организации" Binding="{Binding Phones}" Width="185" />
              <DataGridTextColumn Header="Email организации" Binding="{Binding Email}" Width="210" />
              <DataGridTextColumn Header="Ответственное лицо" Binding="{Binding ResponsiblePerson}" Width="220" />
              <DataGridTextColumn Header="Телефон ответственного" Binding="{Binding ResponsiblePhone}" Width="180" />
              <DataGridTextColumn Header="Email ответственного" Binding="{Binding ResponsibleEmail}" Width="210" />
              <DataGridTextColumn Header="Руководитель" Binding="{Binding Manager}" Width="210" />
              <DataGridTextColumn Header="Статус" Binding="{Binding ContactStatus}" Width="115" />
              <DataGridTextColumn Header="Ошибка" Binding="{Binding ContactError}" Width="260" />
              <DataGridTextColumn Header="Стр." Binding="{Binding SourcePage}" Width="70" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Grid.Row="6"
              Background="#EFF6FF"
              BorderBrush="#BFDBFE"
              BorderThickness="1"
              CornerRadius="9"
              Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Text="{Binding ProgressMessage}" Foreground="#1E3A8A" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CurrentStage}" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
            <DockPanel Margin="0,0,0,4">
              <TextBlock Text="{Binding OverallProgressText}" Foreground="#475569" FontSize="11" DockPanel.Dock="Left" />
              <TextBlock Text="{Binding OverallProgressPercent, StringFormat={}{0:F0}%}" Foreground="#1D4ED8" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Right" />
            </DockPanel>
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding OverallProgressPercent}"
                         Height="7" />
          </StackPanel>

          <Button Grid.Column="2"
                  Content="Мониторинг / логи"
                  Click="OpenMonitor_Click"
                  Background="#DBEAFE"
                  Foreground="#1D4ED8"
                  Margin="0,0,8,0" />

          <Button Grid.Column="3"
                  Content="Отмена"
                  Command="{Binding CancelCommand}"
                  Background="Transparent"
                  Foreground="#1D4ED8" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
