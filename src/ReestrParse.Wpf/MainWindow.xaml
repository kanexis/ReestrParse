<Window x:Class="ReestrParse.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReestrParse"
        Width="1440"
        Height="860"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="32" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="REESTR" Foreground="White" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="PARSE" Foreground="#60A5FA" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="ФГИС ЕИАС" Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2">
          <TextBlock Text="ЭТАПЫ" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12" />

          <Border Background="#1F2937" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="14" Background="#2563EB">
                <TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Регион и сфера" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Text="Подготовка выборки" Foreground="#94A3B8" FontSize="11" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="14" BorderBrush="#475569" BorderThickness="1">
                <TextBlock Text="2" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Организации" Foreground="#CBD5E1" />
                <TextBlock Text="Обход каталога" Foreground="#64748B" FontSize="11" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Padding="12">
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="14" BorderBrush="#475569" BorderThickness="1">
                <TextBlock Text="3" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Выгрузка" Foreground="#CBD5E1" />
                <TextBlock Text="Excel — следующий этап" Foreground="#64748B" FontSize="11" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Row="4" BorderBrush="#334155" BorderThickness="1,1,1,1" CornerRadius="8" Padding="12">
          <StackPanel>
            <TextBlock Text="Источник" Foreground="#94A3B8" FontSize="11" />
            <TextBlock Text="ri.eias.ru" Foreground="White" Margin="0,3,0,0" />
            <TextBlock Text="Selenium WebDriver" Foreground="#60A5FA" FontSize="11" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Workspace -->
    <Grid Grid.Column="1" Margin="34,28,34,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="22" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="18" />
        <RowDefinition Height="*" />
        <RowDefinition Height="18" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Каталог организаций" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="Выберите регион. Система пройдёт пагинацию и соберёт список теплоснабжающих организаций."
                     Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,0" />
        </StackPanel>
        <Border DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="16" Padding="12,6" VerticalAlignment="Top">
          <TextBlock Text="{Binding StatusText}" Foreground="#166534" FontSize="12" />
        </Border>
      </DockPanel>

      <!-- Filters -->
      <Border Grid.Row="2"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="22">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1.25*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Text="Регион" FontWeight="SemiBold" Margin="0,0,0,7" />
            <ComboBox ItemsSource="{Binding Regions}"
                      SelectedItem="{Binding SelectedRegion}"
                      DisplayMemberPath="Name"
                      MinWidth="300" />
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="Сфера" FontWeight="SemiBold" Margin="0,0,0,7" />
            <ComboBox ItemsSource="{Binding Spheres}"
                      SelectedItem="{Binding SelectedSphere}"
                      DisplayMemberPath="Name"
                      MinWidth="220" />
          </StackPanel>

          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Content="Обновить регионы"
                    Command="{Binding LoadRegionsCommand}"
                    Background="#EEF2FF"
                    Foreground="#3730A3"
                    Margin="0,0,10,0" />
            <Button Content="Загрузить организации"
                    Command="{Binding LoadOrganizationsCommand}"
                    Style="{StaticResource PrimaryButton}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Results -->
      <Border Grid.Row="4"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <StackPanel>
              <TextBlock Text="Найденные организации" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Foreground="{StaticResource MutedBrush}"
                       FontSize="12">
                <Run Text="Всего: " />
                <Run Text="{Binding Organizations.Count, Mode=OneWay}"
                     FontWeight="SemiBold" />
              </TextBlock>
            </StackPanel>

            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Поиск по названию организации"
                     VerticalAlignment="Center" />
          </Grid>

          <DataGrid Grid.Row="1"
                    ItemsSource="{Binding FilteredOrganizations}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    RowHeight="38"
                    ColumnHeaderHeight="42"
                    Margin="1">
            <DataGrid.Columns>
              <DataGridTextColumn Header="№" Binding="{Binding SourcePage}" Width="70" />
              <DataGridTextColumn Header="Наименование организации" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Регион" Binding="{Binding RegionName}" Width="210" />
              <DataGridTextColumn Header="Сфера" Binding="{Binding SphereName}" Width="155" />
              <DataGridTextColumn Header="ID ЕИАС" Binding="{Binding ExternalId}" Width="130" />
              <DataGridTextColumn Header="Страница" Binding="{Binding SourcePage}" Width="90" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Status -->
      <Border Grid.Row="6"
              Background="#EFF6FF"
              BorderBrush="#BFDBFE"
              BorderThickness="1"
              CornerRadius="9"
              Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding ProgressMessage}" Foreground="#1E3A8A" />
            <TextBlock Text="{Binding CurrentStage}" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="Отмена"
                  Command="{Binding CancelCommand}"
                  Background="Transparent"
                  Foreground="#1D4ED8" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
