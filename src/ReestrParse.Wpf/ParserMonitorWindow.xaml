<Window x:Class="ReestrParse.Wpf.ParserMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReestrParse — мониторинг парсера"
        Width="1480"
        Height="860"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel>
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Мониторинг парсера"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" />
        <TextBlock Text="Ключевые события по умолчанию; полный telemetry остаётся доступен в подробном режиме и CSV."
                   Foreground="{StaticResource MutedBrush}"
                   Margin="0,6,0,0" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Сбросить метрики"
                Command="{Binding ResetMetricsCommand}"
                Background="#EEF2FF"
                Foreground="#3730A3"
                Margin="0,0,8,0" />
        <Button Content="Очистить лог"
                Command="{Binding ClearLogsCommand}"
                Background="#F3F4F6"
                Foreground="#374151"
                Margin="0,0,8,0" />
        <Button Content="Экспорт CSV"
                Command="{Binding ExportLogsCommand}"
                Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel>
          <TextBlock Text="Этап" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock Text="{Binding CurrentStage}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
          <TextBlock Text="{Binding CurrentOperation}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel>
          <TextBlock Text="Организации" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock FontSize="17" FontWeight="SemiBold">
            <Run Text="{Binding CompletedItems, Mode=OneWay}" />
            <Run Text=" / " />
            <Run Text="{Binding TotalItems, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
            <Run Text="OK " /><Run Text="{Binding SucceededItems, Mode=OneWay}" />
            <Run Text=" · PART " /><Run Text="{Binding PartialItems, Mode=OneWay}" />
            <Run Text=" · ERR " /><Run Text="{Binding FailedItems, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel>
          <TextBlock Text="Скорость" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock Text="{Binding ThroughputText}" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
            <Run Text="среднее " /><Run Text="{Binding AverageItemText}" />
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Grid.Column="6" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel>
          <TextBlock Text="Время / ETA" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock Text="{Binding ElapsedText}" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
            <Run Text="осталось ~ " /><Run Text="{Binding EtaText}" />
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Grid.Column="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel>
          <TextBlock Text="Workers / страница" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock FontSize="17" FontWeight="SemiBold">
            <Run Text="{Binding ActiveWorkers, Mode=OneWay}" />
            <Run Text=" workers" />
          </TextBlock>
          <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
            <Run Text="стр. " /><Run Text="{Binding CurrentPage, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding TotalPages, Mode=OneWay}" />
            <Run Text=" · W " /><Run Text="{Binding WarningEvents, Mode=OneWay}" />
            <Run Text=" · E " /><Run Text="{Binding ErrorEvents, Mode=OneWay}" />
            <Run Text=" · R " /><Run Text="{Binding RetryEvents, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="4"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="8" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
          <TextBlock Text="{Binding CurrentOrganization}"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     DockPanel.Dock="Left" />
          <TextBlock Text="{Binding ProgressCaption}"
                     Foreground="{StaticResource AccentBrush}"
                     FontWeight="SemiBold"
                     DockPanel.Dock="Right" />
        </DockPanel>

        <ProgressBar Grid.Row="2"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding ProgressPercent}"
                     Height="8" />

        <DockPanel Grid.Row="4">
          <TextBlock Text="{Binding LastError}"
                     Foreground="#B91C1C"
                     FontSize="11"
                     TextWrapping="Wrap"
                     DockPanel.Dock="Left" />
          <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" DockPanel.Dock="Right" Margin="16,0,0,0">
            <Run Text="регионов завершено: " /><Run Text="{Binding CompletedRegions, Mode=OneWay}" />
          </TextBlock>
        </DockPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ComboBox ItemsSource="{Binding LogModeOptions}"
                  SelectedItem="{Binding SelectedLogMode}" />

        <ComboBox Grid.Column="2"
                  ItemsSource="{Binding LevelFilters}"
                  SelectedItem="{Binding SelectedLevelFilter}" />

        <TextBox Grid.Column="4"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Поиск по операции, организации, ИНН, коду ошибки, источнику или сообщению" />
      </Grid>

      <Border Grid.Row="2"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <DataGrid ItemsSource="{Binding FilteredLogs}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  RowHeight="34"
                  ColumnHeaderHeight="40"
                  EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="95" />
            <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="70" />
            <DataGridTextColumn Header="Этап" Binding="{Binding Stage}" Width="150" />
            <DataGridTextColumn Header="Операция" Binding="{Binding Operation}" Width="175" />
            <DataGridTextColumn Header="W" Binding="{Binding Worker}" Width="55" />
            <DataGridTextColumn Header="Позиция" Binding="{Binding Position}" Width="85" />
            <DataGridTextColumn Header="Время" Binding="{Binding Duration}" Width="85" />
            <DataGridTextColumn Header="Организация" Binding="{Binding Organization}" Width="260" />
            <DataGridTextColumn Header="ИНН" Binding="{Binding Inn}" Width="115" />
            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="175" />
            <DataGridTextColumn Header="Источник" Binding="{Binding DataSource}" Width="130" />
            <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*" />
            <DataGridTextColumn Header="Ошибка" Binding="{Binding Error}" Width="260" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>
  </Grid>
</Window>
